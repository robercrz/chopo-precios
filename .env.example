# ============================================================
# .env.example - Variables de configuración
# Copia este archivo como .env y ajusta los valores
# ============================================================

# Zona horaria del scheduler
TIMEZONE=America/Merida

# Hora de ejecución del scrape diario (formato 24h)
SCRAPE_HOUR=6
SCRAPE_MINUTE=0

# Puerto del dashboard Streamlit
DASHBOARD_PORT=8501

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Playwright: True para ejecutar sin ventana, False para ver el browser
HEADLESS=True
